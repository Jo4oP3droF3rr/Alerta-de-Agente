# Copie para .env e preencha:  cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore).
# Gere tokens e senhas com:  openssl rand -hex 32

# Domínio/subdomínio apontado para o IP da VPS (registro A no DNS).
DOMINIO=avisos.seudominio.com.br

# Token para ENVIAR avisos (quem dispara: n8n, Shopify, Claude Code, curl...).
TOKEN_ENVIO=troque-por-um-token-longo-de-envio

# Token para LER avisos e baixar atualizações (vai dentro do app desktop).
# Precisa ser diferente do TOKEN_ENVIO.
TOKEN_LEITURA=troque-por-um-token-longo-de-leitura

# Banco de dados (Postgres do docker-compose).
POSTGRES_USER=alerta
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=alerta

# Quantos avisos guardar no banco (os mais antigos são apagados). 0 = guarda todos.
MAX_AVISOS=0

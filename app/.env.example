# Copie para .env e preencha. O .env NUNCA vai para o Git (está no .gitignore).
# Sem estas variáveis o app funciona só com o webhook local (127.0.0.1:5055).

# Endereço do servidor na VPS (o mesmo DOMINIO do server/.env, com https://).
SERVIDOR_URL=https://avisos.seudominio.com.br

# O TOKEN_LEITURA do server/.env (não use o token de envio aqui).
SERVIDOR_TOKEN=cole-aqui-o-token-de-leitura

# Opcional: destino do "npm run publicar" (envia a atualização para a VPS via scp).
PUBLICAR_SCP_DESTINO=usuario@IP-DA-VPS:/opt/alerta-de-agente/server/updates/
